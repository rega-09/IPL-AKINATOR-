# ─────────────────────────────────────────────────────────────────────────────
# IPL Akinator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── FIREBASE ──────────────────────────────────────────────────────────────────
# Path to your Firebase service account key JSON
# See firebase/setup_firebase.md for instructions
FIREBASE_CREDENTIALS=firebase/serviceAccountKey.json

# ── GAME SETTINGS ─────────────────────────────────────────────────────────────
MAX_QUESTIONS=8
CONFIDENCE_THRESHOLD=0.80

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: * (allow all)
# Production : your Firebase Hosting URL (e.g. https://ipl-akinator.web.app)
ALLOWED_ORIGINS=*

# ── SERVER ────────────────────────────────────────────────────────────────────
# Set automatically by Render in production — leave blank locally
# PORT=8000
